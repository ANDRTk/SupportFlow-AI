    {
      "parameters": {
        "jsCode": "\nconst item = $input.first();\n\n// 1. Отримуємо оригінальні байти HTTP Body\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst rawBody = buffer.toString('utf8');\n\n// 2. Точний URL, зареєстрований у Trello\nconst callbackURL =\n  'https://YOUR_N8N_HOST/webhook/trello-replies';\n\n// 3. Отримуємо підпис, який надіслав Trello\nconst receivedSignature =\n  item.json.headers?.['x-trello-webhook'] ?? '';\n\n// 4. Готуємо дані для HMAC-SHA1\nconst signatureInput = rawBody + callbackURL;\n\n// 5. Розбираємо JSON для наступних нод\nconst payload = JSON.parse(rawBody);\n\nreturn [\n  {\n    json: {\n      signature_input: signatureInput,\n      received_signature: receivedSignature,\n      action: payload.action,\n      model: payload.model\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
